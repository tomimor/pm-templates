{
  // Rule docs: https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
  "config": {
    "default": true,
    // line-length: noisy on spec docs and wide tables
    "MD013": false,
    // PR template opens with H2 sections, no single top-level H1
    "MD041": false
  },
  // "*.md" keeps root files (AGENTS.md) covered locally too: the CI action
  // always lints root markdown, so without it local and CI scope would differ.
  "globs": ["*.md", "docs/**/*.md", ".github/**/*.md"]
}
